# codebase-scanner needs no secrets and makes no network calls.
# These optional environment variables only change defaults; the matching
# command line flags (--top, --max-file-bytes) take precedence.
# The tool reads the process environment and does not load a .env file itself.

# How many largest files to list.
CODEBASE_SCANNER_TOP_N=10

# Files larger than this many bytes are sized but not read.
CODEBASE_SCANNER_MAX_FILE_BYTES=1000000
